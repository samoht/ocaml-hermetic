# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Check every Eio library of a source tree against hermetic.eio"
description: """
The hermetic-tree command indexes a source tree, selects each library that
does its I/O through Eio, by its name or by its dependency on eio, and checks
its compiled units as hermetic-check --eio does, against a ratchet file of the
libraries still allowed to violate, which may only shrink."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["org:blacksun" "test" "area:static_analysis"]
homepage: "https://tangled.org/gazagnaire.org/ocaml-hermetic"
bug-reports: "https://tangled.org/gazagnaire.org/ocaml-hermetic/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.4"}
  "cmdliner" {>= "1.3.0"}
  "eio"
  "eio_main"
  "fmt" {>= "0.9"}
  "fpath"
  "hermetic" {= version}
  "nox-dune"
  "project-index"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/ocaml-hermetic"
x-maintenance-intent: ["(latest)"]

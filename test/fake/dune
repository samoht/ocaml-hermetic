; A small standard library, compiled without the real one, with shapes the
; real one lacks today: an unreviewed value and submodule, an alias of a
; submodule, a generative functor, a functor of an anonymous parameter, an
; abstract module type, a keyword operator, a value named unsafe, a class,
; a class type, a new module that aliases another new one, and values that
; hand out a channel, a formatter or output closures, or take one. Its
; interfaces are kept as .sig files, which this rule copies and compiles.

(rule
 (targets
  stdlib.mli
  stdlib__List.mli
  stdlib__Random.mli
  stdlib__Odd.mli
  stdlib__Classy.mli
  stdlib__Typed.mli
  stdlib__Labels.mli
  stdlib.cmi
  stdlib__List.cmi
  stdlib__Random.cmi
  stdlib__Odd.cmi
  stdlib__Classy.cmi
  stdlib__Typed.cmi
  stdlib__Labels.cmi)
 (deps
  stdlib.sig
  stdlib__List.sig
  stdlib__Random.sig
  stdlib__Odd.sig
  stdlib__Classy.sig
  stdlib__Typed.sig
  stdlib__Labels.sig)
 (action
  (progn
   (copy stdlib.sig stdlib.mli)
   (copy stdlib__List.sig stdlib__List.mli)
   (copy stdlib__Random.sig stdlib__Random.mli)
   (copy stdlib__Odd.sig stdlib__Odd.mli)
   (copy stdlib__Classy.sig stdlib__Classy.mli)
   (copy stdlib__Typed.sig stdlib__Typed.mli)
   (copy stdlib__Labels.sig stdlib__Labels.mli)
   (run
    %{bin:ocamlc}
    -nostdlib
    -nopervasives
    -w
    -a
    -no-alias-deps
    -c
    stdlib.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__List.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__Random.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__Labels.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__Odd.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__Classy.mli)
   (run %{bin:ocamlc} -nostdlib -nopervasives -w -a -c stdlib__Typed.mli))))

; A use of each value the prelude refuses on the installed compiler fails to
; compile, on the type of its refusal.

(rule
 (deps
  (glob_files %{ocaml_where}/*.cmi)
  (glob_files %{ocaml_where}/unix/*.cmi)
  (glob_files %{ocaml_where}/threads/*.cmi))
 (action
  (with-stdout-to
   uses.txt
   (run %{exe:../../lib/gen/gen.exe} --uses %{ocaml_where}))))

(rule
 (alias runtest)
 (package hermetic)
 (deps
  uses.sh
  uses.txt
  %{bin:ocamlc}
  (glob_files ../../lib/.hermetic.objs/byte/*.cmi)
  (glob_files ../../lib/.hermetic_unix.objs/byte/*.cmi)
  (glob_files ../../lib/.hermetic_threads.objs/byte/*.cmi))
 (action
  (run
   sh
   uses.sh
   uses.txt
   ../../lib/.hermetic.objs/byte
   ../../lib/.hermetic_unix.objs/byte
   ../../lib/.hermetic_threads.objs/byte)))

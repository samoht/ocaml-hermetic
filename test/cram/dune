(cram
 (deps
  %{bin:dune}
  (package hermetic)))

(cram
 (applies_to link unix threads)
 (deps %{bin:ocamlobjinfo}))

(cram
 (applies_to link-native)
 (enabled_if
  (<> %{ocaml-config:architecture} none))
 (deps %{bin:nm}))

(cram
 (applies_to stdlib-types)
 (deps %{bin:ocamlc} %{bin:ocamlfind}))

(cram
 (applies_to mtime)
 (enabled_if %{lib-available:mtime.clock}))

(cram
 (applies_to eio-units)
 (enabled_if %{lib-available:eio.unix})
 (deps %{bin:ocamlc} %{bin:ocamlfind}))

; A domain is new in OCaml 5.0.

(cram
 (applies_to domain)
 (enabled_if
  (>= %{ocaml_version} 5.0)))

; ocamlobjinfo lists the units of a bytecode executable from OCaml 5.2;
; link-native.t checks the same on every compiler.

(cram
 (applies_to link)
 (enabled_if
  (>= %{ocaml_version} 5.2)))

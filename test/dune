; The tests read the compiler's messages, which a caller forcing colour
; (CLICOLOR_FORCE, as setup-ocaml sets) would fill with escape codes.

(env
 (_
  (env-vars
   (CLICOLOR_FORCE 0)
   (OCAML_COLOR never))))

(test
 (name test)
 (package hermetic)
 (deps
  %{bin:ocamlc}
  (glob_files fake/*.cmi))
 (action
  (setenv
   OCAMLC
   %{bin:ocamlc}
   (run %{test})))
 (libraries hermetic hermetic_gen alcotest))

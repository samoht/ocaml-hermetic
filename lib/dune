; The prelude's units are generated from the installed compiler's standard
; library and the policy in gen/policy.ml. The library is not wrapped: each
; unit is named Hermetic__X already, and Hermetic is a module of aliases to
; them, so that a program links only the units it uses. The restated Unix
; is compiled against the interface of the compiler's unix library, but the
; library does not depend on unix, which forces its link: a program that
; names only Unix's types links none of it, and one that uses a value of
; Unix names unix among its libraries, as it would without the prelude.

(library
 (name hermetic)
 (public_name hermetic)
 (wrapped false)
 (flags
  (:standard -I +unix)))

(include dune.inc)

(rule
 (with-stdout-to
  dune.inc.gen
  (run %{exe:gen/gen.exe} --dune)))

(rule
 (alias runtest)
 (package hermetic)
 (action
  (diff dune.inc dune.inc.gen)))
